# ============================================================================
# COMERSYS — VARIABLES DE ENTORNO PARA PRODUCCIÓN
# ============================================================================

# Puerto del servidor web (Render / Railway / VPS asigna $PORT automáticamente)
PORT=8000

# Entorno de ejecución: production / development
NODE_ENV=production

# Ruta al archivo de persistencia de datos multi-tenant
DATA_PATH=./data/comersys_platform.json

# Orígenes CORS permitidos (* para desarrollo o tu dominio en producción)
ALLOWED_ORIGINS=*
