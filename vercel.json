{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "includeFiles": "css/**,js/**,assets/**,admin-central/**,data/**,index.html,favicon.svg,favicon.ico"
    },
    "server.js": {
      "includeFiles": "css/**,js/**,assets/**,admin-central/**,data/**,index.html,favicon.svg,favicon.ico"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?url=/api/$1" },
    { "source": "/health", "destination": "/api/index.js?url=/health" },
    { "source": "/api/health", "destination": "/api/index.js?url=/api/health" },
    { "source": "/admin", "destination": "/api/index.js?url=/admin" },
    { "source": "/admin/", "destination": "/api/index.js?url=/admin" },
    { "source": "/admin/css/(.*)", "destination": "/api/index.js?url=/admin/css/$1" },
    { "source": "/admin/js/(.*)", "destination": "/api/index.js?url=/admin/js/$1" },
    { "source": "/admin/(.*)", "destination": "/api/index.js?url=/admin/$1" },
    { "source": "/admin-central/(.*)", "destination": "/api/index.js?url=/admin/$1" }
  ]
}
